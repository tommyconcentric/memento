<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE stays
	     YES). Only keys with no INFOPLIST_KEY_ build-setting equivalent
	     belong here. remote-notification lets CloudKit push changes to the
	     app in the background, so cross-device sync doesn't wait for the
	     next launch. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
